daemon off;
error_log /dev/stdout info;

events { worker_connections 1024; }

http {
  include /app/config/mime.types;
  access_log /dev/stdout;

  server {
    listen <%= ENV["PORT"] %>;
    server_name _;
    root /app;   # ou /app si vos fichiers HTML sont à la racine

    location / {
      index index.html;
      try_files $uri $uri/ =404;
    }
  }
}