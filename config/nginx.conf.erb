daemon off;
worker_processes 1;
error_log /dev/stdout info;

events { worker_connections 1024; }

http {
  include /app/config/mime.types;
  access_log /dev/stdout;
  sendfile on;

  server {
    listen <%= ENV["PORT"] %>;
    server_name _;
    root /app;
    index index.html;

    location / {
      try_files $uri $uri/ =404;
    }
  }
}